# Ҳисоботи тавлидии `npm run speaking:audit` — натиҷа, на манбаъ
speaking-audit-report.txt

# Экспорти ҳисобҳо пеш аз нест кардан — маълумоти шахсии корбарон дорад,
# ҳеҷ гоҳ ба репозиторий наравад.
_backups/

# Артефактҳои МУВАҚҚАТӢ-и скриптҳои мазмун.
#
# `prisma/tmp/zh-audio` 2,3 МБ файли MP3-и сохташуда дошт, ки аллакай ба CDN
# бор шуда буданд. Дар git онҳо ҳеҷ фоида надоранд ва то абад дар таърих
# мемонанд — репо бо ҳар даври аудио вазнинтар мешавад.
prisma/tmp/
