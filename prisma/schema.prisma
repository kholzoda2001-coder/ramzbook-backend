generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(cuid())
  email         String? @unique
  phone         String? @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  isActive      Boolean @default(true)
  nativeLang    String  @default("tg") // UI / interface language code
  interfaceLang String  @default("tg")
  targetLang    String? // currently-learning language code
  country       String? // ISO 3166-1 alpha-2, detected from IP on first login

  // Stats
  totalXp         Int     @default(0)
  weeklyXp        Int     @default(0)
  gems            Int     @default(0)
  level           String  @default("A1")
  currentCourseId String?

  // Hearts
  hearts             Int      @default(5)
  maxHearts          Int      @default(5)
  lastHeartRegen     DateTime @default(now())
  // Суръати барқароршавии дил (дақиқа) — вобаста ба сатҳ+модули охирине, ки
  // корбар мехонад. A1 M1=1, A1 M2=30, A1 M3+=60, A2=300, B1=720, B2=1080, C1=1440.
  heartsRegenMinutes Int      @default(30)

  // Streak
  streak                 Int       @default(0)
  longestStreak          Int       @default(0)
  lastActiveDate         DateTime?
  streakFreezesAvailable Int       @default(1)
  streakFreezesUsed      Int       @default(0)

  // Premium (legacy fields — kept for the Google Play webhook flow)
  isPremium        Boolean   @default(false)
  premiumPlan      String? // "monthly" | "yearly" | "lifetime"
  premiumStartedAt DateTime?
  premiumExpiresAt DateTime?
  trialUsed        Boolean   @default(false)
  trialStartedAt   DateTime?

  // Freemium subscription system (canonical going forward)
  subscriptionTier   String    @default("free") // free | premium
  subscriptionPlan   String? // monthly | yearly
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  // AI Tutor
  aiConversationsToday   Int      @default(0)
  aiConversationsResetAt DateTime @default(now())

  /// Зинаи ҷории лига (1 Бронза … 5 Алмос) — КЭШИ хондан.
  ///
  /// ⚠️ ҲАМЕША бо `set:` навишта мешавад, ҳеҷ гоҳ бо `increment:`. Манбаи
  /// ҳақиқат `LeagueResult.newTier`-и охирин аст, ва он аз (ҷой, зина, шумораи
  /// аъзо) ҳисоб мешавад — функсияи СОФ. Маҳз ҳамин чиз такрори кори
  /// ҳафтагиро бехатар мекунад: дубора иҷро шудан ҳамон рақамро мебарорад,
  /// на як зина болотар. Ниг. `lib/league.ts` → `closeWeek()`.
  leagueTier   Int      @default(1)

  // Misc
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Push (FCM) — ниг. lib/push.ts ва lib/pushMessages.ts
  /// Тугмаи «Огоҳномаҳо» дар профил. Пеш танҳо дар телефон (SharedPreferences)
  /// нигоҳ дошта мешуд, бинобар ин сервер онро намедонист ва push ба корбари
  /// хомӯшкарда ҳам мерафт. Акнун сервер онро эҳтиром мекунад.
  pushEnabled  Boolean   @default(true)
  /// Вақти охирини push — маҳдудкунандаи басомад (на бештар аз 1 дар рӯз).
  lastPushAt   DateTime?
  /// Марҳилаи охирини win-back, ки ба ин корбар фиристода шуд (3/7/14/30).
  /// Ба ҷои «тирезаи 24-соата» — агар як cron нашавад, корбар гум намешавад.
  winbackStage Int       @default(0)
  /// Лаҳзаи охирини кори ВОҚЕИИ таълимӣ — ягона сигнали боэътимоди «имрӯз хондааст»
  /// барои огоҳиҳо. Ниг. `lib/activity.ts`.
  ///
  /// ЧАРО майдони алоҳида: `lastActiveAt`/`lastActiveDate`-ро танҳо `awardXp`
  /// менависад, ва он ТАНҲО ҳангоми хатми АВВАЛИНИ дарс даъват мешавад
  /// (`firstCompletion`). Яъне такрори дарс, такрори муколамаи speaking ва
  /// тамоми навбати такрор (SRS) барои сервер НОАЁН буданд — хонандае, ки
  /// ҳамон бегоҳ ним соат такрор мекард, «имрӯз нахондааст» ҳисоб мешуд ва
  /// push мегирифт. Ин майдон ҳар амали таълимиро сабт мекунад, бе XP.
  lastStudyAt  DateTime?
  /// Фарқи вақти ДАСТГОҲИ корбар аз UTC, ба дақиқа (Душанбе = 300, Маскав = 180).
  /// Аз `/mobile/push/register` меояд. Бе ин ҳама push бо соати Душанбе меравад
  /// ва муҳоҷир дар Маскав ёдрасони «21:30»-ро соати 19:30 мегирад.
  tzOffsetMin  Int?

  // Relations
  progress             UserProgress[]
  achievements         UserAchievement[]
  subscriptions        Subscription[]
  payments             Payment[]
  gemTransactions      GemTransaction[]
  streakWagers         StreakWager[]
  userLanguages        UserLanguage[]
  refreshTokens        RefreshToken[]
  dailyXp              DailyXp[]
  promoRedemptions     PromoRedemption[]
  paymentTransactions  PaymentTransaction[]
  paywallEvents        PaywallEvent[]
  feedbacks            Feedback[]
  srsCards             SrsCard[]
  friendInvitesCreated FriendInvite[]
  friendStreaksAsUser1 FriendStreak[]       @relation("FriendStreakUser1")
  friendStreaksAsUser2 FriendStreak[]       @relation("FriendStreakUser2")
  deviceTokens         DeviceToken[]
  pushSends            PushSend[]
  speakingProgress     SpeakingProgress[]
  leagueMemberships    LeagueMember[]
  leagueResults        LeagueResult[]
  contentReports       ContentReport[]

  @@index([email])
  @@index([phone])
  @@index([isPremium])
  @@index([subscriptionTier])
}

/// FCM device tokens барои push-и серверӣ. Як корбар метавонад чанд дастгоҳ
/// дошта бошад; token уникал аст (як дастгоҳ = як token).
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android") // android | ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Кампанияи push — ПУРРА аз панели админ идора мешавад (ҳеҷ матн дар код нест).
///
/// Ду навъ:
///  * `scheduled` — автоматӣ, ҳаррӯза дар вақти муайян (бо вақти МАҲАЛЛИИ
///    интихобшуда, пешфарз Душанбе UTC+5);
///  * `manual` — як бор аз панел фиристода мешавад (broadcast).
///
/// Матн барои ҳар забон ҷудо (`texts`) ва бо ҷойгузорҳо ({name}, {streak},
/// {lesson}, {countdown}…) — ниг. `lib/pushTemplate.ts`.
model PushCampaign {
  id       String  @id @default(cuid())
  name     String // «Огоҳии нарм 19:00 — тоҷикӣ»
  kind     String  @default("scheduled") // scheduled | manual
  isActive Boolean @default(true)

  // ── Ҷадвал (вақти маҳаллӣ) ──
  hour        Int     @default(19)
  minute      Int     @default(0)
  tzOffsetMin Int     @default(300) // Душанбе = UTC+5 = 300 дақиқа
  weekdays    String? // "1,2,3,4,5" (1=Дш … 7=Яш); null = ҳаррӯза

  // ── Сегмент (ҳама null = ҳама корбарони дорои token) ──
  langs           String? // "tg,ru" — interfaceLang
  tier            String? // free | premium
  studiedToday    String? // yes | no
  minStreak       Int?
  maxStreak       Int?
  minInactiveDays Int?
  maxInactiveDays Int?
  levels          String? // "A1,A2"
  countries       String? // "TJ,RU"
  /// yes = силсилаи ҷуфтӣ бо дӯст ФАЪОЛ дорад | no = надорад | null = фарқ надорад.
  /// Ҷои ёдрасони маҳаллии 102 (`FriendStreak.status = 'active'`).
  friendStreak    String?
  /// yes = гарави алмос («Дубора ё ҳеҷ») ФАЪОЛ дорад | no | null.
  /// Ҷои ёдрасони маҳаллии 103 (`StreakWager.status = 'active'`).
  wager           String?

  // ── Мазмун ──
  texts           Json // { tg: {title, body}, ru: {...}, en: {...} }
  route           String @default("lesson") // тап → куҷо
  /// Соати маҳаллии «дедлайн» барои ҷойгузори {countdown} (мас. 24 = нимишаб).
  countdownToHour Int?

  // ── Идора ──
  priority      Int       @default(0) // хурдтар = аввалтар иҷро мешавад
  cooldownHours Int       @default(20) // ҳамон кампания ба ҳамон корбар
  lastRunAt     DateTime?
  lastRunSent   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sends PushSend[]

  @@index([isActive, kind])
}

/// Таърихи ҳар як push — барои таърих, статистика ва ҳисоби маҳдудиятҳо.
model PushSend {
  id          String        @id @default(cuid())
  campaignId  String?
  campaign    PushCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignKey String? // slug барои филтр (мас. streak_soft)
  title       String
  body        String
  status      String // sending | sent | failed | skipped
  reason      String? // сабаби skip/fail
  createdAt   DateTime      @default(now())
  /// Вақте корбар ба ҳамин огоҳӣ ЗАД (`/mobile/push/opened`). Бе ин мо танҳо
  /// «фиристодем»-ро медонем, на «расид ва кор кард» — яъне CTR намедонем.
  openedAt    DateTime?

  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Language {
  id           String   @id @default(cuid())
  code         String   @unique // en, ru, tr, etc
  name         String // English exonym, e.g. "Tajik"
  nativeName   String // endonym, e.g. "Тоҷикӣ"
  flag         String // emoji flag
  canBeNative  Boolean  @default(false) // usable as UI / interface language
  canBeTarget  Boolean  @default(true) // usable as a learnable language
  badge        String? // HOT | LIVE | SOON
  learnerCount String? // "1.5B learners"
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // ── Language-agnostic runtime config (driven from admin, NOT code) ──
  // Adding a new language requires only these DB fields — no app changes.
  ttsLocale      String? // BCP-47 for text-to-speech, e.g. "en-US", "ar-SA"
  sttLocale      String? // BCP-47 for speech-to-text (often == ttsLocale)
  direction      String  @default("ltr") // "ltr" | "rtl" (Arabic, Hebrew, Farsi → rtl)
  fontFamily     String? // optional custom font, e.g. "Noto Sans Arabic"
  hasIPA         Boolean @default(true) // show phonetic transcription for this language
  exerciseConfig Json? // which exercise types are enabled for this language

  coursesAsTarget         Course[]            @relation("TargetLang")
  coursesAsNative         Course[]            @relation("NativeLang")
  uiTranslations          UiTranslation[]
  userLanguages           UserLanguage[]
  cefrDescriptorsAsTarget CefrDescriptor[]    @relation("DescriptorTarget")
  cefrDescriptorsAsNative CefrDescriptor[]    @relation("DescriptorNative")
  placementAsTarget       PlacementQuestion[] @relation("PlacementTarget")
  placementAsNative       PlacementQuestion[] @relation("PlacementNative")
  onboardingAsTarget      OnboardingWord[]    @relation("OnboardingTarget")
  onboardingAsNative      OnboardingWord[]    @relation("OnboardingNative")
  alphabetAsTarget        AlphabetLetter[]    @relation("AlphabetTarget")
  alphabetAsNative        AlphabetLetter[]    @relation("AlphabetNative")
  alphabetRulesAsTarget   AlphabetRule[]      @relation("AlphabetRuleTarget")
  alphabetRulesAsNative   AlphabetRule[]      @relation("AlphabetRuleNative")
  speakingAsTarget        SpeakingCategory[]  @relation("SpeakingTarget")
  speakingAsNative        SpeakingCategory[]  @relation("SpeakingNative")
}

model UserLanguage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  languageId String
  language   Language @relation(fields: [languageId], references: [id])

  fromLang     String // tg, ru, etc
  currentLevel String   @default("A1")
  xp           Int      @default(0)
  streak       Int      @default(0)
  isCurrent    Boolean  @default(false)
  goal         String? // travel, work, study, social, culture, tech
  startedAt    DateTime @default(now())

  @@unique([userId, languageId])
  @@index([userId])
}

model Course {
  id               String   @id @default(cuid())
  // A course is bound to a (target, native) language PAIR.
  targetLanguageId String
  targetLanguage   Language @relation("TargetLang", fields: [targetLanguageId], references: [id])
  nativeLanguageId String
  nativeLanguage   Language @relation("NativeLang", fields: [nativeLanguageId], references: [id])
  level            String // A1, A2, B1, B2, C1
  title            String // shown in native language
  description      String?
  emoji            String
  color            String // hex color
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  modules           Module[]
  grammarTopics     GrammarTopic[]
  phraseCollections PhraseCollection[]
  dialogues         Dialogue[]
  comprehensions    ComprehensionExercise[]

  @@unique([targetLanguageId, nativeLanguageId, level])
  @@index([targetLanguageId])
  @@index([nativeLanguageId])
}

model Module {
  id              String  @id @default(cuid())
  courseId        String
  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String // target-language title, e.g. "Foundations"
  titleTranslated String // native-language title, e.g. "Асосҳо"
  emoji           String
  color           String  @default("#10B981")
  order           Int     @default(0)
  isPremium       Boolean @default(false) // requires Premium
  isBoss          Boolean @default(false) // boss module
  isActive        Boolean @default(true)
  // ── "Can-do" statement for this SECTION, in the learner's native language ──
  // Shown on the path under the section header ("Пас аз ин бахш дар бораи оила
  // ва хонаи худ нақл карда метавонед."). Distinct from CefrDescriptor, which
  // is scoped to a whole CEFR LEVEL and a skill — this one names the concrete
  // thing this section alone makes possible. Nullable: the row is simply not
  // rendered until an editor writes it, so a section without copy looks
  // finished rather than broken.
  canDoStatement  String? @db.Text
  // ── Версияи мазмуни БАХШ ──────────────────────────────────────────────
  // Бахш воҳиди зеркашии офлайн аст (тирезаи 3-бахшӣ), пас версия ҳам маҳз
  // ин ҷо меистад. Ҳар навиштан ба дарс/калима/компоненти дохили ин бахш
  // рақамро як зина боло мебарад (ниг. `lib/contentVersion.ts`), ва барнома
  // ҳангоми кушодан рақами худро бо ин муқоиса мекунад.
  //
  // ⚠️ ЧАРО ин ба `AppSetting.content_version`-и глобалӣ илова мешавад, на
  // ҷои онро мегирад: он як парчами арзони «умуман чизе тағйир ёфт?» аст ва
  // барои кэши SWR кор мекунад. Вале он ГЛОБАЛӢ аст ва ба хонанда намегӯяд,
  // ки маҳз КАДОМ бахш кӯҳна шудааст — бе ин рақам барнома пас аз огоҳии
  // «хато ислоҳ шуд» ҳамон сатри кӯҳнаро нишон медиҳад.
  contentVersion  Int     @default(1)

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id                 String                 @id @default(cuid())
  moduleId           String
  module             Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title              String // target-language title, e.g. "Greetings"
  titleTranslated    String // native-language title, e.g. "Саломҳо"
  type               String                 @default("vocab") // "vocab" | "quiz" (legacy display tag)
  // ── CEFR framework (Step 2) ──
  cefrLevel          String? // A1…C2 — falls back to the course level if null
  skillType          String                 @default("vocab") // vocab|grammar|reading|listening|speaking|writing|review|test
  emoji              String
  xpReward           Int                    @default(60)
  duration           Int                    @default(5) // minutes
  order              Int                    @default(0)
  isPremium          Boolean                @default(false)
  isActive           Boolean                @default(true)
  // ── Unified path (Step 11): a lesson is one step in the sequence; by skillType
  // it may link to any one component, which the player renders inline ──
  grammarTopicId     String?
  grammarTopic       GrammarTopic?          @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  phraseCollectionId String?
  phraseCollection   PhraseCollection?      @relation(fields: [phraseCollectionId], references: [id], onDelete: SetNull)
  dialogueId         String?
  dialogue           Dialogue?              @relation(fields: [dialogueId], references: [id], onDelete: SetNull)
  comprehensionId    String?
  comprehension      ComprehensionExercise? @relation(fields: [comprehensionId], references: [id], onDelete: SetNull)

  words    Word[]
  progress UserProgress[]

  @@index([moduleId])
  @@index([grammarTopicId])
  @@index([phraseCollectionId])
  @@index([dialogueId])
  @@index([comprehensionId])
}

model Word {
  id            String  @id @default(cuid())
  lessonId      String
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word          String // target-language word, e.g. "Hello"
  translation   String // native-language translation, e.g. "Салом"
  emoji         String?
  ipa           String? // /həˈloʊ/
  ipaTajik      String? // e.g. "Ҳеллоу"
  example       String? // target-language example sentence
  exampleTrans  String? // native-language translation of the example
  audioUrl      String?
  difficulty    Int     @default(1) // 1-5
  // ── CEFR framework (Step 2) ──
  partOfSpeech  String? // noun|verb|adjective|adverb|phrase|… (language-agnostic tag)
  frequencyRank Int? // lower = more frequent → learn earlier
  order         Int     @default(0)

  @@index([lessonId])
}

// CEFR "can-do" descriptor — the measurable target per (target,native) pair + level.
// Language-agnostic: defined entirely from the admin panel, never hardcoded.
model CefrDescriptor {
  id               String   @id @default(cuid())
  targetLanguageId String
  targetLanguage   Language @relation("DescriptorTarget", fields: [targetLanguageId], references: [id], onDelete: Cascade)
  nativeLanguageId String
  nativeLanguage   Language @relation("DescriptorNative", fields: [nativeLanguageId], references: [id], onDelete: Cascade)
  cefrLevel        String // A1…C2
  skill            String   @default("overall") // overall|reading|writing|listening|speaking
  canDo            String   @db.Text // "can-do" statement shown in the native language
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([targetLanguageId, nativeLanguageId, cefrLevel])
}

// ── Placement test (Phase 5) — language-agnostic, admin-driven ──
// A placement question belongs to a (target, native) language PAIR, NOT a single
// course, because a placement test spans MULTIPLE CEFR levels. Each question is
// tagged with the level it probes; the scoring engine infers the learner's level
// from which levels they answer correctly. Multiple-choice so it auto-grades
// (no human evaluation needed). Nothing here is hardcoded per language.
model PlacementQuestion {
  id               String   @id @default(cuid())
  targetLanguageId String
  targetLanguage   Language @relation("PlacementTarget", fields: [targetLanguageId], references: [id], onDelete: Cascade)
  nativeLanguageId String
  nativeLanguage   Language @relation("PlacementNative", fields: [nativeLanguageId], references: [id], onDelete: Cascade)
  cefrLevel        String // A1…C2 — the level this question probes
  skill            String   @default("overall") // overall|reading|writing|listening|speaking|grammar|vocab
  prompt           String   @db.Text // the question (usually target language)
  promptTranslated String?  @db.Text // native-language hint/translation
  options          Json // string[] of answer options
  answer           String   @db.Text // the correct option (must equal one of options)
  explanation      String?  @db.Text // native-language reason shown after answering
  audioUrl         String? // for listening-type placement items
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([targetLanguageId, nativeLanguageId, cefrLevel])
  @@index([targetLanguageId, nativeLanguageId, isActive])
}

// 🎯 Onboarding Zero-Lesson
// A very simple introductory lesson for a language pair
model OnboardingWord {
  id                 String   @id @default(cuid())
  targetLanguageId   String
  targetLanguage     Language @relation("OnboardingTarget", fields: [targetLanguageId], references: [id], onDelete: Cascade)
  nativeLanguageId   String
  nativeLanguage     Language @relation("OnboardingNative", fields: [nativeLanguageId], references: [id], onDelete: Cascade)
  word               String // target-language word, e.g. "Hello"
  translation        String // native-language translation, e.g. "Салом"
  transcription      String? // IPA or transliteration
  transcriptionTajik String?
  emoji              String? // e.g. "👋"
  example            String? // "Hello, friend!"
  exampleTrans       String? // "Салом, дӯстам!"
  options            Json // string[] of translation options for the quiz
  audioUrl           String?
  order              Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([targetLanguageId, nativeLanguageId])
}

// 🔤 Alphabet — one row per letter of the target language's script, scoped to
// a (target, native) language pair like OnboardingWord (an alphabet doesn't
// vary by course/CEFR level, only by which script the target language uses).
model AlphabetLetter {
  id                 String   @id @default(cuid())
  targetLanguageId   String
  targetLanguage     Language @relation("AlphabetTarget", fields: [targetLanguageId], references: [id], onDelete: Cascade)
  nativeLanguageId   String
  nativeLanguage     Language @relation("AlphabetNative", fields: [nativeLanguageId], references: [id], onDelete: Cascade)
  uppercase          String // "A", "Б", ...
  lowercase          String // "a", "б", ...
  ipa                String? // international phonetic symbol, e.g. "/eɪ/"
  tajikTranscription String? // Tajik-script pronunciation hint, e.g. "Эй"
  category           String // "vowel" | "consonant" | "sign"
  // Studio recording of the letter's NAME. Without it the app falls back to the
  // device's TTS, which on many phones has no voice installed for the target
  // language (silence) or only a network voice (audible lag on rapid taps —
  // exactly what the alphabet drill does). A hosted file is instant and always
  // the same voice as the rest of the course.
  audioUrl           String?
  order              Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([targetLanguageId, nativeLanguageId, order])
}

// ── Alphabet rules — short pronunciation/spelling notes shown above the
// letter grid, one set per (target, native) pair, grouped by `category` so the
// app can show vowel rules on the Садонокҳо tab, consonant rules on the
// Ҳамсадоҳо tab, and `general` rules on the combined Алфавит tab. 100%
// admin-managed, exactly like AlphabetLetter — no rules are hardcoded in the app.
model AlphabetRule {
  id               String   @id @default(cuid())
  targetLanguageId String
  targetLanguage   Language @relation("AlphabetRuleTarget", fields: [targetLanguageId], references: [id], onDelete: Cascade)
  nativeLanguageId String
  nativeLanguage   Language @relation("AlphabetRuleNative", fields: [nativeLanguageId], references: [id], onDelete: Cascade)
  category         String // "vowel" | "consonant" | "general"
  title            String // short heading, e.g. "«e»-и хомӯш"
  body             String // the rule text, in the learner's native language
  order            Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([targetLanguageId, nativeLanguageId, order])
}

// ── Grammar system (Step 3) — language-agnostic, admin-driven ──
// A grammar topic belongs to a course (so it inherits the target/native pair).
model GrammarTopic {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cefrLevel       String? // A1…C2 — falls back to the course level if null
  title           String // target-language title, e.g. "Present Simple"
  titleTranslated String // native-language title, e.g. "Замони ҳозираи содда"
  explanation     String   @db.Text // Markdown explanation, written in the native language
  emoji           String   @default("🔤")
  order           Int      @default(0)
  isPremium       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  examples  GrammarExample[]
  rules     GrammarRule[]
  exercises GrammarExercise[]
  lessons   Lesson[] // lessons that teach this topic

  @@index([courseId])
}

model GrammarExample {
  id          String       @id @default(cuid())
  topicId     String
  topic       GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sentence    String // target-language example sentence
  translation String // native-language translation
  audioUrl    String?
  highlight   String? // substring of `sentence` to emphasise (e.g. the conjugated verb)
  order       Int          @default(0)

  @@index([topicId])
}

model GrammarRule {
  id      String       @id @default(cuid())
  topicId String
  topic   GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  pattern String // e.g. "Subject + do/does + base verb"
  note    String?      @db.Text // native-language note explaining the rule
  order   Int          @default(0)

  @@index([topicId])
}

model GrammarExercise {
  id               String       @id @default(cuid())
  topicId          String
  topic            GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type             String       @default("fill_blank") // fill_blank | choose | reorder | transform
  prompt           String       @db.Text // the question (target language, may contain "___")
  promptTranslated String?      @db.Text // native-language hint/translation
  answer           String // the correct answer
  options          Json? // string[] of options for "choose" / "reorder" types
  explanation      String?      @db.Text // native-language reason the answer is correct
  order            Int          @default(0)

  @@index([topicId])
}

// ── Sentence / Phrase bank (Step 5) — language-agnostic, admin-driven ──
// A phrase collection belongs to a course (inherits the target/native pair).
// Used for teaching ready-made useful sentences/phrases (greetings, travel…),
// each with target text, native translation, optional literal gloss + audio.
model PhraseCollection {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cefrLevel       String? // A1…C2 — falls back to the course level if null
  category        String? // free language-agnostic tag, e.g. "greetings", "travel"
  title           String // target-language title, e.g. "At the Restaurant"
  titleTranslated String // native-language title, e.g. "Дар тарабхона"
  emoji           String   @default("💬")
  order           Int      @default(0)
  isPremium       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  phrases Phrase[]
  lessons Lesson[] // lessons that teach this collection

  @@index([courseId])
}

model Phrase {
  id           String           @id @default(cuid())
  collectionId String
  collection   PhraseCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  text         String           @db.Text // target-language phrase/sentence
  translation  String           @db.Text // native-language translation
  literal      String?          @db.Text // optional word-by-word / literal gloss
  note         String?          @db.Text // native-language usage note
  audioUrl     String?
  order        Int              @default(0)

  @@index([collectionId])
}

// ── Dialogue system (Step 7) — language-agnostic, admin-driven ──
// A dialogue belongs to a course (inherits the target/native pair). It is an
// ordered conversation between two or more speakers, each line with target
// text + native translation + optional audio. `isUser` marks "my" turns.
model Dialogue {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cefrLevel       String? // A1…C2 — falls back to the course level if null
  title           String // target-language title, e.g. "Ordering Coffee"
  titleTranslated String // native-language title, e.g. "Фармоиши қаҳва"
  scenario        String?  @db.Text // native-language setup/description of the situation
  emoji           String   @default("🎙️")
  order           Int      @default(0)
  isPremium       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  lines   DialogueLine[]
  lessons Lesson[] // lessons that play this dialogue

  @@index([courseId])
}

model DialogueLine {
  id          String   @id @default(cuid())
  dialogueId  String
  dialogue    Dialogue @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  speaker     String // speaker name/label, e.g. "Barista", "Alex"
  text        String   @db.Text // target-language line
  translation String   @db.Text // native-language translation
  audioUrl    String?
  isUser      Boolean  @default(false) // true → this line belongs to the learner ("me")
  order       Int      @default(0)

  @@index([dialogueId])
}

// Reading/listening comprehension: a passage (or audio transcript) plus
// multiple-choice questions that test understanding. Language-agnostic — the
// passage language is the course's target language; questions/options/native
// hints all come from admin content, never hard-coded.
model ComprehensionExercise {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cefrLevel         String? // A1…C2 — falls back to the course level if null
  kind              String   @default("reading") // reading | listening
  title             String // target-language title
  titleTranslated   String // native-language title
  passage           String   @db.Text // the reading text, or the transcript for a listening clip
  passageTranslated String?  @db.Text // optional native-language translation of the passage
  audioUrl          String? // audio clip URL (used for "listening" kind)
  emoji             String   @default("📖")
  order             Int      @default(0)
  isPremium         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  questions ComprehensionQuestion[]
  lessons   Lesson[] // lessons that use this exercise

  @@index([courseId])
}

model ComprehensionQuestion {
  id                 String                @id @default(cuid())
  exerciseId         String
  exercise           ComprehensionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  question           String                @db.Text // the question (usually target language)
  questionTranslated String?               @db.Text // optional native-language version of the question
  options            Json // string[] of answer choices
  correctIndex       Int                   @default(0) // index into options of the correct answer
  explanation        String?               @db.Text // native-language reason the answer is correct
  order              Int                   @default(0)

  @@index([exerciseId])
}

// Spaced-repetition review card (SM-2). One row per (user, item). Item-agnostic
// via (itemType, itemId) so the same engine serves vocabulary, phrases, grammar,
// etc. — never hard-coded to a language. The scheduler stores only the SM-2
// state; the underlying content (word/translation/…) is hydrated at read time.
model SrsCard {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType       String    @default("word") // word | phrase | grammar | dialogue_line | …
  itemId         String // id of the underlying content item
  courseId       String? // lets the review queue be filtered per course
  easeFactor     Float     @default(2.5) // SM-2 ease (min 1.3)
  intervalDays   Int       @default(0) // current interval in days
  repetitions    Int       @default(0) // consecutive correct reviews
  lapses         Int       @default(0) // times forgotten ("again")
  dueAt          DateTime  @default(now()) // when this card next becomes reviewable
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, itemType, itemId])
  @@index([userId, dueAt])
  @@index([userId, courseId])
}

/// Гузориши хатои МАЗМУН, ки худи хонанда фиристодааст.
///
/// ЧАРО ВУҶУД ДОРАД: RAMZ ба забонҳое паҳн мешавад, ки соҳиби маҳсулот онҳоро
/// намедонад. Ин хонандаро ба мусаҳҳеҳ табдил медиҳад — ва маҳз бинобар ин
/// [field] ҳатмист: «дар ин экран хато ҳаст» бефоида аст, «тарҷумаи модарии
/// ҳамин калима хато аст» — ислоҳшаванда.
///
/// ⚠️ [contentId] МАШҚ нест, балки худи МАЗМУН аст (`Word.id`,
/// `GrammarTopic.id`, …). Машқҳо дар телефон аз калимаҳо СОХТА мешаванд ва
/// id-и устувор надоранд: як калима дар як дарс ҳамчун `choose`, `type` ва
/// `intro` пайдо мешавад. Агар гурӯҳбандӣ ба машқ баста мешуд, ҳашт гузориш
/// дар ЯК сатр ба се гурӯҳи ҷудо мешикаст — дақиқан он чизе, ки талаб
/// «як сатр, як бор ҳал мекунам» рад мекунад.
model ContentReport {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Дарсе, ки хонанда дар он буд — барои кушодани он аз огоҳӣ.
  lessonId     String
  /// Бахш — версияи мазмуни он ҳангоми ҳал як зина боло меравад.
  moduleId     String?
  /// Id-и МАЗМУН (Word.id ва ғ.), на машқ. Ниг. тавзеҳи боло.
  contentId    String
  /// Навъи машқе, ки хонанда дар он буд — танҳо барои контекст дар панел.
  exerciseType String
  /// Калиди майдон: `word_target`, `word_native`, `ipa`, `audio`, `option_2`…
  /// Рӯйхат дар `frontend/lib/features/report/report_fields.dart` муайян аст.
  field        String
  /// Қимате, ки хонанда дар лаҳзаи гузориш ДИДА буд.
  value        String  @db.Text

  /// wrong_translation | spelling | unnatural | other
  reason       String
  suggestion   String? @db.Text

  /// new | fixed | rejected
  status       String  @default("new")

  /// Оё 5 алмос барои ин гузориш аллакай дода шудааст?
  ///
  /// ⚠️ МАҲЗ ин парчам ду бор зер кардани «Ҳал шуд»-ро бехатар мекунад:
  /// транзаксия танҳо сатрҳои `rewarded = false`-ро мукофот медиҳад. Бе он
  /// зеркунии дуюм ба ҳамон корбарон боз 5 алмос медод.
  rewarded     Boolean @default(false)

  uiLanguage   String?
  course       String?
  appVersion   String?

  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  // Панели админ маҳз бо ҳамин ҷуфт гурӯҳбандӣ мекунад.
  @@index([contentId, field, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model UiTranslation {
  id         String   @id @default(cuid())
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  key        String // "home.title"
  value      String   @db.Text // "Хона"

  @@unique([languageId, key])
  @@index([languageId])
}

model OtpCode {
  id             String   @id @default(cuid())
  identifier     String // normalized email or phone
  channel        String // "email" | "phone"
  otpHash        String // HMAC-SHA256 of the code
  expiresAt      DateTime
  used           Boolean  @default(false)
  verifyAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([identifier, used])
}

model AppSetting {
  key       String   @id // e.g. "login_settings", "auth_providers"
  valueJson String   @db.Text
  updatedAt DateTime @updatedAt
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  isCompleted Boolean   @default(false)
  accuracy    Int       @default(0) // percentage
  xpEarned    Int       @default(0)
  timeSpent   Int       @default(0) // seconds
  heartsLost  Int       @default(0)
  completedAt DateTime?

  // «Реклама бин → XP дучанд». Вақти супоридани бонус, ё `null` агар
  // ҳанӯз гирифта нашуда бошад.
  //
  // ЧАРО МАЙДОНИ ҶУДОГОНА, на ҳисоб аз `xpEarned`: бе нишондиҳандаи
  // возеҳ даъвати такрорӣ XP-ро боз ду баробар мекард (2× → 4× → 8×).
  // Ин ягона муҳофиз аст, ки «як дарс — як бонус»-ро кафолат медиҳад.
  xpDoubledAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId])
}

// ══ «Устоди AI · Speaking» — бахши ПУРРА МУСТАҚИЛ ═══════════════════════════
//
// ЧАРО ҷудо: спикинг як роҳи алоҳида аст (мисли Falou), НА қадами роҳнамои
// курс. Он ба `Course`/`Module`/`Lesson`/`UserProgress` тамоман даст намезанад,
// бинобар ин машқи гуфтор ҳеҷ гоҳ дарсҳои A1–B1-ро «гузашта» намекунад ва
// қулфҳои роҳнаморо намекушояд.
//
// Ҳудуд — ҶУФТИ ЗАБОН (омӯзиш ← модарӣ), на курс ва на сатҳ: ҳамон намунае,
// ки `AlphabetLetter`, `PlacementQuestion` ва `OnboardingWord` истифода
// мебаранд. Пас барои «англисӣ ← тоҷикӣ» як маҷмӯи ягонаи категорияҳо ҳаст,
// новобаста аз он ки хонанда дар кадом сатҳи роҳнамост.
//
// Сатҳ (A1/A2…) ҚАСДАН НЕСТ: тартиб (`order`) душвориро муайян мекунад,
// айнан мисли бобҳои Falou.
model SpeakingCategory {
  id               String   @id @default(cuid())
  targetLanguageId String
  targetLanguage   Language @relation("SpeakingTarget", fields: [targetLanguageId], references: [id], onDelete: Cascade)
  nativeLanguageId String
  nativeLanguage   Language @relation("SpeakingNative", fields: [nativeLanguageId], references: [id], onDelete: Cascade)
  title            String // ба забони омӯзиш, мас. "Ordering a drink"
  titleTranslated  String // ба забони модарӣ, мас. "Фармоиши нӯшокӣ"
  scenario         String?  @db.Text // тавсифи вазъият ба забони модарӣ
  emoji            String   @default("🎙️")
  order            Int      @default(0) // тартиб = душворӣ
  isPremium        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  lessons SpeakingLesson[]

  @@index([targetLanguageId, nativeLanguageId])
}

// Як дарси дохили категория — воҳиди ЯК нишасти машқ.
//
// Falou категорияро ба дарсҳои хурд мешиканад («2 lessons for next chapter»):
// ҳар дарс чанд калимаи нав мегирад ва ҳамонҳоро дар ҷумлаҳо машқ мекунонад.
// Прогресс маҳз ин ҷо ҳисоб мешавад — категория вақте тамом мешавад, ки ҳамаи
// дарсҳояш гузашта бошанд.
model SpeakingLesson {
  id         String           @id @default(cuid())
  categoryId String
  category   SpeakingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String? // ихтиёрӣ; холӣ бошад — «Дарси N»
  order      Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

  items    SpeakingItem[]
  progress SpeakingProgress[]

  @@index([categoryId])
}

// Як воҳиди машқ: калима Ё ҷумла — ҳарду дар як дарс зиста метавонанд.
//
// Тартиби Falou: калимаи нав (машқи «бигӯед») → ҷумлаҳое, ки ҳамон калимаро
// кор мефармоянд (машқи «тарҷума кунед») → калимаи нави дигар…
model SpeakingItem {
  id          String         @id @default(cuid())
  lessonId    String
  lesson      SpeakingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind        String         @default("sentence") // "word" | "sentence"
  text        String         @db.Text // матн ба забони омӯзиш
  translation String         @db.Text // тарҷума ба забони модарӣ
  literal     String?        @db.Text // калима ба калима / транслитератсия
  note        String?        @db.Text // шарҳи истифода ба забони модарӣ
  audioUrl    String?
  order       Int            @default(0)

  @@index([lessonId])
}

// Прогресси спикинг — ҚАСДАН аз `UserProgress` ҶУДО (ниг. шарҳи боло).
model SpeakingProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         SpeakingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  timesCompleted Int            @default(1)
  xpEarned       Int            @default(0)
  timeSpent      Int            @default(0) // сония
  completedAt    DateTime       @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Achievement {
  id                      String @id @default(cuid())
  code                    String @unique // streak_7, xp_100, lessons_10, etc
  name                    String
  nameTranslations        Json // { tg, ru, en, uz }
  emoji                   String
  description             String
  descriptionTranslations Json
  rarity                  String // common | rare | epic | legendary
  conditionType           String // streak | xp | lessons | premium
  conditionValue          Int
  xpReward                Int    @default(0)
  gemsReward              Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  plan   String // monthly | yearly | lifetime
  status String // active | cancelled | expired | trial | grace_period

  // Google Play
  googlePurchaseToken String? @unique
  googleOrderId       String?
  googleProductId     String // vip_monthly, vip_yearly, ramz_lifetime

  startedAt   DateTime  @default(now())
  expiresAt   DateTime?
  cancelledAt DateTime?
  autoRenew   Boolean   @default(true)

  @@index([userId, status])
  @@index([googlePurchaseToken])
}

model Payment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  amount   Float
  currency String @default("USD")
  plan     String
  status   String // pending | success | failed | refunded

  // Google Play
  googleOrderId       String? @unique
  googlePurchaseToken String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model GemTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int // positive = earned, negative = spent
  reason    String // lesson_complete, streak_freeze, heart_refill, etc
  createdAt DateTime @default(now())

  @@index([userId])
}

model DailyTask {
  id           String  @id @default(cuid())
  userId       String
  taskType     String // learn_words, complete_lesson, practice_time
  targetValue  Int
  currentValue Int     @default(0)
  reward       Int // gems
  date         String // YYYY-MM-DD
  completed    Boolean @default(false)

  @@unique([userId, date, taskType])
  @@index([userId, date])
}

// Per-day XP log — drives the weekly activity chart and analytics.
// One row per user per day; `source` is a JSON breakdown by XP type.
model DailyXp {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime @db.Date
  xp     Int      @default(0)
  source Json? // { lesson: 60, perfect: 20, achievement: 50, ... }

  @@unique([userId, date])
  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Freemium subscription system
// ─────────────────────────────────────────────────────────────────────────────

/// Gateway-agnostic transaction log: subscriptions, gem packs, trials.
/// Canonical record for Alif Mobi / DC Pay / Stripe / Apple / Google / mock.
model PaymentTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String // subscription | gems | trial
  provider    String // alif | dcpay | stripe | apple | google | mock
  amount      Float // currency major units (e.g. 4.99)
  currency    String   @default("USD")
  status      String   @default("pending") // pending | success | failed | refunded
  plan        String? // monthly | yearly (subscription)
  gemsAmount  Int? // gems credited (gem purchases)
  promoCodeId String? // applied promo, if any
  externalId  String? // gateway transaction / order id
  metadata    Json? // raw gateway payload, A/B variant, trigger, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([externalId])
}

/// Reusable discount / trial-extension codes.
model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String // percent | fixed | trial_days
  discountValue  Int // percent 0-100 | cents | days
  appliesTo      String    @default("both") // monthly | yearly | both | gems
  maxRedemptions Int? // null = unlimited
  timesRedeemed  Int       @default(0)
  perUserLimit   Int       @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  redemptions PromoRedemption[]

  @@index([code])
  @@index([isActive])
}

/// One row per (promo, user) redemption — enforces perUserLimit + analytics.
model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  redeemedAt  DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([userId])
}

/// Paywall impressions + outcomes. Powers frequency-capping (so we stay
/// non-aggressive) and the Phase 7 conversion funnel.
// ── Library — books, audiobooks, video courses and templates, 100%
// admin-managed (nothing is hardcoded in the app). One table covers every
// type; `type` decides which fields matter:
//   book/template → pages[]        audio/video → mediaUrl + durationMin
model LibraryItem {
  id          String   @id @default(cuid())
  type        String   @default("book") // book | audio | video | template
  title       String
  author      String?
  description String?  @db.Text
  coverUrl    String?
  /// CEFR level this item suits (A1…C2). Null = any level.
  level       String?
  /// Target language the item teaches, e.g. "en". Null = shown for all.
  targetLang  String?
  /// Streaming/download URL for audio and video items.
  mediaUrl    String?
  durationMin Int?
  rating      Float?
  isPremium   Boolean  @default(false)
  isActive    Boolean  @default(true)
  /// Lower first inside its type.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages LibraryPage[]

  @@index([type, isActive, order])
  @@index([targetLang])
}

model LibraryPage {
  id       String      @id @default(cuid())
  itemId   String
  item     LibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order    Int         @default(0)
  title    String?
  content  String      @db.Text
  imageUrl String?

  @@index([itemId, order])
}

// ── In-app feedback — what learners actually think, in their own words.
// Asked ONCE, after a configurable number of finished lessons (see
// lib/feedback.ts), and always available from the profile. Deliberately NOT
// wired to the Google Play review prompt: routing happy users to the store and
// unhappy ones to a form is a banned dark pattern on both stores.
model Feedback {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  rating           Int // 1..5 (1 = 😠 … 5 = 😍)
  message          String?  @db.Text
  source           String   @default("lesson_milestone") // lesson_milestone | profile
  // Context captured at submit time, so a comment can be read against where
  // the learner actually was — without joining live (and changing) user rows.
  lessonsCompleted Int      @default(0)
  level            String?
  targetLang       String?
  platform         String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
  @@index([userId])
}

model PaywallEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  trigger   String // streak_at_risk | lives_empty | lesson_5 | level_locked | league_promoted | weekly_recap | inactive_14d | manual
  // shown            — пейвол намоиш дода шуд
  // started_trial    — тугма зада шуд, плани интихобшуда trial дорад
  // purchase_started — тугма зада шуд, плани интихобшуда trial НАДОРАД
  // purchased        — Google тасдиқ кард ВА сервер санҷид
  // dismissed        — экран бе харид пӯшида шуд
  //
  // `started_trial`/`purchase_started` НИЯТанд, на натиҷа: онҳо маҳз пеш аз
  // рафтан ба равзанаи пардохти Google сабт мешаванд. Фарқи байни онҳо ва
  // `purchased` нишон медиҳад, ки корбарон дар куҷо мераванд — дар худи экран
  // ё аллакай дар пардохти Google.
  action    String   @default("shown")
  variant   String? // A/B variant label
  context   Json? // user segment, offer shown, etc.
  createdAt DateTime @default(now())

  @@index([userId, trigger])
  @@index([trigger, action])
  @@index([createdAt])
}

/// "Double or Nothing" streak wager — the single most concretely-proven
/// individual retention mechanic found in the P0-P4 retention research pass
/// (Duolingo reports +14% Day-7 retention from this exact feature). A user
/// stakes gems on keeping their streak alive for [targetDays] more days; win
/// pays back double, loss forfeits the stake. Resolution is lazy (checked on
/// read, see lib/wager.ts) against [lastSeenStreak] so a break is detected
/// even though we don't log day-by-day — see resolveWager()'s doc comment
/// for why that's still correct.
model StreakWager {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemsWagered    Int
  targetDays     Int
  startStreak    Int // user.streak at the moment the wager was placed
  lastSeenStreak Int // updated on each lazy check; a drop below this means the streak broke
  status         String    @default("active") // active | won | lost
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([userId, status])
}

/// Short-lived, single-use invite code for pairing a "Friend Streak" (see
/// FriendStreak below). Deliberately NOT a friend-request/discovery system —
/// the code itself, shared out-of-band via Share.share(), IS the consent
/// mechanism: whoever redeems it deliberately typed in a secret the creator
/// chose to hand them. 24h expiry + single-use keeps the blast radius small
/// if a code leaks somewhere it shouldn't.
model FriendInvite {
  id               String    @id @default(cuid())
  code             String    @unique // 6 chars, uppercase, unambiguous alphabet (see lib/friendStreak.ts)
  creatorUserId    String
  creator          User      @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?
  createdAt        DateTime  @default(now())

  @@index([creatorUserId])
  @@index([code])
}

/// Duolingo's "Friend Streak" — a joint streak shared with exactly one other
/// user (Duolingo reports +22% daily-lesson completion for users with an
/// active one). v1 supports ONE active pairing per user (not Duolingo's
/// up-to-5), matching this app's current ~30-user scale.
///
/// Resolution is lazy, exactly like StreakWager (see lib/friendStreak.ts's
/// resolveFriendStreak() for the full reasoning) — no cron job. Each side
/// tracks its OWN [startStreakN]/[lastSeenStreakN] against that same side's
/// live User.streak, because the two users' streak counters are completely
/// independent counters that happen to be compared. If EITHER side's live
/// streak has dropped below that side's lastSeen checkpoint, the joint
/// streak is broken for both. Otherwise the joint "days" shown to both users
/// is min(user1.streak - startStreak1, user2.streak - startStreak2).
model FriendStreak {
  id              String    @id @default(cuid())
  user1Id         String
  user1           User      @relation("FriendStreakUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id         String
  user2           User      @relation("FriendStreakUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  startStreak1    Int // user1.streak at the moment the pairing was formed
  startStreak2    Int // user2.streak at the moment the pairing was formed
  lastSeenStreak1 Int // updated on each lazy check; a drop below this means user1's side broke
  lastSeenStreak2 Int // updated on each lazy check; a drop below this means user2's side broke
  status          String    @default("active") // active | broken
  createdAt       DateTime  @default(now())
  brokenAt        DateTime?

  @@index([user1Id, status])
  @@index([user2Id, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Лига — мусобиқаи ҳафтаинаи когортҳои то 30 нафар
//
// ЧАРО: рейтинги ҷаҳонӣ ҳамаи ~1240 корбарро дар як рӯйхат мегузошт, пас қариб
// ҳама дар ҷое меистоданд, ки ҳеҷ гоҳ иваз карда наметавонистанд. Когортаи
// 30-нафара мусобиқаро ВОҚЕАН бурданӣ мекунад.
//
// Марзи ҳафта: шанбе 00:00 UTC, калид = санаи ҳамон шанбе ("2026-08-29").
// UTC барои ҲАМА — ҳафтаи ҳар корбар алоҳида бошад, когортро тартиб додан
// имконнопазир мешавад. `DailyXp.date` ҳам бо UTC калид мешавад, пас ду манбаъ
// бо ҳам мувофиқанд.
// ─────────────────────────────────────────────────────────────────────────────

/// Як когорта: як зина, як ҳафта, то 30 нафар.
model League {
  id    String @id @default(cuid())
  /// 1 Бронза · 2 Нуқра · 3 Тилло · 4 Платина · 5 Алмос
  tier  Int
  /// Санаи ШАНБЕи оғози ҳафта, "YYYY-MM-DD" (UTC).
  weekKey String

  /// Шумораи аъзо — денормализатсия шуда, то ҷустуҷӯи «когортаи кушод» як
  /// дархости индексдор бошад.
  ///
  /// ⚠️ ҲЕҶ ГОҲ бо read-then-write нав карда намешавад: ду корбар ҳамзамон
  /// 29-ро мехонанд ва ҳарду дохил мешаванд → 31. Навиштан ҳамеша ШАРТӢ аст
  /// (`updateMany where memberCount < 30`), ниг. `lib/league.ts`.
  memberCount Int @default(0)

  /// Лаҳзаи бастани ҳафта. Муҳофизати идемпотентии №1 — иҷрои дуюм ин
  /// когортаро тамоман мегузаронад.
  rolledOverAt DateTime?

  createdAt DateTime @default(now())

  members LeagueMember[]
  results LeagueResult[]

  /// Ҷустуҷӯи «когортаи кушоди ин зина дар ин ҳафта» — маҳз ҳамин индекс.
  @@index([weekKey, tier, memberCount])
  @@index([weekKey, rolledOverAt])
}

/// Узвият: як корбар дар як когорта дар як ҳафта.
model LeagueMember {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Аз `League` денормализатсия шуд, то `awardXp` узвияти ҷориро бо ЯК
  /// дархости индексдор ёбад (бе join).
  weekKey String

  /// XP-и ҲАМИН ҳафта. Ҳангоми ҳар мукофоти XP зиёд мешавад — ҳеҷ гоҳ аз
  /// таърих ҷамъ карда НАМЕШАВАД (талаби кор).
  weeklyXp Int @default(0)

  /// Ҷои корбар дар лаҳзаи ОХИРИН дидан — барои тирчаҳои ҳаракат (боло/поён).
  startRank Int?

  joinedAt DateTime @default(now())

  /// Як когорта дар як ҳафта. Ин ҳам гейти «дубора ҷойгир накун» аст.
  @@unique([userId, weekKey])
  /// Тартиби ҷадвали лига.
  @@index([leagueId, weeklyXp])
}

/// Натиҷаи бойгонишудаи як ҳафта барои як корбар.
model LeagueResult {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  weekKey  String

  /// Зинае, ки дар он мусобиқа кард.
  tier      Int
  finalRank Int
  weeklyXp  Int
  /// Шумораи аъзои когорта — барои матни «Аз 30 нафар ҷои 7-ум».
  memberCount Int @default(0)

  /// promoted | stayed | demoted
  outcome String
  /// Зинаи НАВ — МУТЛАҚ, на фарқ. Аз (finalRank, tier, memberCount) ҳисоб
  /// мешавад, пас такроран ҳисоб кардан ҳамон рақамро медиҳад.
  newTier Int

  gemsReward Int      @default(0)
  claimed    Boolean  @default(false)
  claimedAt  DateTime?
  createdAt  DateTime @default(now())

  /// Муҳофизати идемпотентии №2: ҳатто агар ду иҷро ҳамзамон аз гейти
  /// `rolledOverAt` гузаранд, дуюмаш P2002 мегирад, на сатри такрорӣ.
  @@unique([userId, weekKey])
  /// «Натиҷаи гирифтанашуда ҳаст?» — дархости экрани оғози барнома.
  @@index([userId, claimed])
}
