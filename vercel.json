{
  "buildCommand": "prisma generate && prisma db push --accept-data-loss && next build",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/push",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/push",
      "schedule": "0 15 * * *"
    }
  ]
}
