  {
    "id": "seed:ordering_food_en_tg:L2:I4",
    "kind": "sentence",
    "text": "Can I have the menu?",
    "translation": "Менюро дода метавонед?",
    "literal": "кен ай ҳэв зэ меню",
    "note": "«Can I have…?» — шакли хушмуомилаи дархост. Ҷавоби маъмулӣ: «Sure!»",
    "audioUrl": null,
    "cue": "Here you are. Do you need anything else?",
    "cueTranslation": "Мана. Боз чизе лозим аст?"
  },
  {
    "id": "seed:ordering_food_en_tg:L2:I5",
    "kind": "sentence",
    "text": "Can I have a table for two?",
    "translation": "Мизе барои ду нафар ҳаст?",
    "literal": "кен ай ҳэв э тейбл фор ту",
    "note": "«for two» = «барои ду нафар». Калимаи people гуфтан лозим нест.",
    "audioUrl": null,
    "cue": "Good evening! How many people?",
    "cueTranslation": "Шоми хуш! Чанд нафаред?"
  },
  {
    "id": "seed:ordering_food_en_tg:L2:I6",
    "kind": "sentence",
    "text": "Can I have water, please?",
    "translation": "Об дода метавонед, лутфан?",
    "literal": "кен ай ҳэв уотэр плиз",
    "note": null,
    "audioUrl": null,
    "cue": "Would you like something to drink?",
    "cueTranslation": "Чизе нӯшидан мехоҳед?"
  },
